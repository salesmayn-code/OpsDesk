# Copy to .env before running locally.
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=7
CSRF_SECRET=dev-csrf-secret-change-me-00000000000
# The web app proxies /api/v1 (next.config.ts), so cookies are first-party: keep "lax".
COOKIE_SAMESITE=lax
# Proxy hops in front of the API: 0 locally, 2 for Vercel rewrite → Railway.
TRUST_PROXY_HOPS=0
# Run the SLA/outbox/auto-close worker inside the API (single-service deploys).
RUN_EMBEDDED_WORKER=false
# Enable the public /register flow (demo deployments set this to true).
ALLOW_SELF_REGISTRATION=true
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="OpsDesk <no-reply@opsdesk.local>"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PER_TICKET=10
ORG_TIMEZONE=Asia/Karachi
LOG_LEVEL=info
